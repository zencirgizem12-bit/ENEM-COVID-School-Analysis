# ======================================================
# 01_load_data.R
# Load ENEM panel, merge excess mortality, create treatment and instrument
# ======================================================

library(dplyr)

# Load ENEM city panel (2017-2021)
city_panel_full <- readRDS("C:/Users/Admin/Desktop/4.step/nufus_verisi/city_panel_2017_2021.rds")

# Load excess mortality (calculated separately)
excess <- read.csv("C:/Users/Admin/Desktop/4.step/excess_mortality_brazil_2020_corrected.csv")

# Merge excess mortality into panel
city_panel_full <- city_panel_full %>%
  left_join(excess[, c("municipio_code", "excess_mortality_positive")],
            by = c("city_code" = "municipio_code"))

# Create post-2021 dummy
city_panel_full$post2021 <- ifelse(city_panel_full$year == 2021, 1, 0)

# Standardize key variables
city_panel_full$internet_std <- scale(city_panel_full$pct_full_remote)
city_panel_full$excess_std <- scale(city_panel_full$excess_mortality_positive)

# Create treatment (D) and instrument (Z)
city_panel_full$D <- city_panel_full$post2021 * city_panel_full$internet_std
city_panel_full$Z <- city_panel_full$post2021 * city_panel_full$excess_std * city_panel_full$internet_std

# Save processed data
saveRDS(city_panel_full, "city_panel_processed.rds")


# ======================================================
# 02_excess_mortality.R
# Calculate excess mortality from SIM data (BigQuery export)
# ======================================================

# Load SIM mortality data (downloaded from BigQuery)
obitos <- read.csv("C:/Users/Admin/Downloads/sim_obitos_2015_2020.csv")
colnames(obitos) <- c("ano", "id_municipio", "obitos")

# Load population data (processed from IBGE Excel files)
pop <- read.csv("C:/Users/Admin/Desktop/populasyon/brazil_municipality_population_2015_2020_corrected.csv")
pop$population <- as.numeric(gsub("\\.", "", pop$population))
pop$municipio_code <- as.integer(pop$municipio_code)

# Merge and calculate mortality rates
merged <- merge(pop, obitos,
                by.x = c("year", "municipio_code"),
                by.y = c("ano", "id_municipio"),
                all.x = TRUE)
merged$obitos[is.na(merged$obitos)] <- 0
merged$mortality_rate <- (merged$obitos / merged$population) * 100000
merged <- merged[merged$population > 0 & is.finite(merged$mortality_rate), ]

# Compute expected 2020 mortality using 2015-2019 linear trend (municipality-specific)
municipalities <- unique(merged$municipio_code)
trend_list <- list()

for (mun in municipalities) {
  d <- merged[merged$municipio_code == mun & merged$year %in% 2015:2019, ]
  if (nrow(d) < 3) next
  d$log_rate <- log(d$mortality_rate + 0.01)
  mod <- lm(log_rate ~ year, data = d)
  pred_log <- predict(mod, newdata = data.frame(year = 2020))
  expected_rate <- exp(pred_log) - 0.01
  trend_list[[as.character(mun)]] <- data.frame(
    municipio_code = mun,
    expected_mortality_2020 = as.numeric(expected_rate)
  )
}
expected_df <- do.call(rbind, trend_list)

# Actual 2020 mortality
actual_2020 <- merged[merged$year == 2020, c("municipio_code", "mortality_rate")]
colnames(actual_2020)[2] <- "actual_mortality_2020"

# Calculate excess mortality
excess <- merge(actual_2020, expected_df, by = "municipio_code", all = TRUE)
excess$excess_mortality <- excess$actual_mortality_2020 - excess$expected_mortality_2020
excess$excess_mortality[is.na(excess$excess_mortality)] <- 0
excess$excess_mortality_positive <- pmax(excess$excess_mortality, 0)

# Save results
write.csv(excess, "excess_mortality_brazil_2020_corrected.csv", row.names = FALSE)

# ======================================================
# 03_did_iv_models.R
# Estimate DiD and IV models with clustered standard errors
# ======================================================

library(lmtest)
library(sandwich)
library(AER)

# Load processed data
city_panel_full <- readRDS("city_panel_processed.rds")

# DiD (simple)
did1 <- lm(math_mean ~ D + factor(city_code) + factor(year), data = city_panel_full)
did1_clustered <- coeftest(did1, vcov = vcovCL, cluster = ~ city_code)

# DiD + controls (income median and urban share)
did2 <- lm(math_mean ~ D + income_median + pct_urban + factor(city_code) + factor(year),
           data = city_panel_full)
did2_clustered <- coeftest(did2, vcov = vcovCL, cluster = ~ city_code)

# IV (simple)
iv1 <- ivreg(math_mean ~ D + factor(city_code) + factor(year) |
               Z + factor(city_code) + factor(year), data = city_panel_full)
iv1_summary <- summary(iv1, diagnostics = TRUE)

# IV + controls
iv2 <- ivreg(math_mean ~ D + income_median + pct_urban + factor(city_code) + factor(year) |
               Z + income_median + pct_urban + factor(city_code) + factor(year),
             data = city_panel_full)
iv2_summary <- summary(iv2, diagnostics = TRUE)

# Save results
save(did1_clustered, did2_clustered, iv1_summary, iv2_summary,
     file = "model_results.RData")

# Print key coefficients
cat("\n=== DiD (simple) ===\n")
print(did1_clustered["D", ])
cat("\n=== DiD + controls ===\n")
print(did2_clustered["D", ])
cat("\n=== IV (simple) ===\n")
print(iv1_summary$coefficients["D", ])
cat("\n=== IV + controls ===\n")
print(iv2_summary$coefficients["D", ])

# ======================================================
# 04_heterogeneity_placebo.R
# High/low mortality split and placebo tests
# ======================================================

library(lmtest)
library(sandwich)

# Load processed data
city_panel_full <- readRDS("city_panel_processed.rds")

# High vs low mortality split (median split)
med_excess <- median(city_panel_full$excess_mortality_positive, na.rm = TRUE)
city_panel_full$high_mort <- ifelse(city_panel_full$excess_mortality_positive > med_excess, 1, 0)

# DiD on high mortality subsample
did_high <- lm(math_mean ~ D + factor(city_code) + factor(year),
               data = city_panel_full[city_panel_full$high_mort == 1, ])
did_high_clustered <- coeftest(did_high, vcov = vcovCL, cluster = ~ city_code)

# DiD on low mortality subsample
did_low <- lm(math_mean ~ D + factor(city_code) + factor(year),
              data = city_panel_full[city_panel_full$high_mort == 0, ])
did_low_clustered <- coeftest(did_low, vcov = vcovCL, cluster = ~ city_code)

# Placebo test with fake post = 2018 (using 2017-2019 sample)
placebo_data <- subset(city_panel_full, year %in% c(2017, 2018, 2019))
placebo_data$post2018 <- ifelse(placebo_data$year == 2018, 1, 0)
placebo_data$D_placebo <- placebo_data$post2018 * placebo_data$internet_std

did_placebo <- lm(math_mean ~ D_placebo + factor(city_code) + factor(year), data = placebo_data)
did_placebo_clustered <- coeftest(did_placebo, vcov = vcovCL, cluster = ~ city_code)

# Save results
save(did_high_clustered, did_low_clustered, did_placebo_clustered,
     file = "heterogeneity_placebo_results.RData")

# Print results
cat("\n=== High mortality subsample DiD ===\n")
print(did_high_clustered["D", ])
cat("\n=== Low mortality subsample DiD ===\n")
print(did_low_clustered["D", ])
cat("\n=== Placebo DiD (fake post = 2018) ===\n")
print(did_placebo_clustered["D_placebo", ])

