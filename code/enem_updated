ggsave(paste0(downloads_path, "figure5_scores_by_subject.png"), plot = p5, width = 8, height = 5, dpi = 300)

# -----------------------------------------------------
# Figure 6: Event study (internet x year coefficients)
# -----------------------------------------------------
city_panel_full$inter_2017 <- city_panel_full$internet_std * (city_panel_full$year == 2017)
city_panel_full$inter_2018 <- city_panel_full$internet_std * (city_panel_full$year == 2018)
city_panel_full$inter_2021 <- city_panel_full$internet_std * (city_panel_full$year == 2021)

event_model <- lm(math_mean ~ inter_2017 + inter_2018 + inter_2021 +
                    factor(city_code) + factor(year), data = city_panel_full)

coefs <- coef(event_model)[c("inter_2017", "inter_2018", "inter_2021")]
vcov_mat <- vcovCL(event_model, cluster = ~ city_code)
ses <- sqrt(diag(vcov_mat))[c("inter_2017", "inter_2018", "inter_2021")]

fig6_data <- data.frame(
  year = c(2017, 2018, 2021),
  coef = coefs,
  lower = coefs - 1.96 * ses,
  upper = coefs + 1.96 * ses
)
fig6_data <- rbind(fig6_data, data.frame(year = 2019, coef = 0, lower = 0, upper = 0))

p6 <- ggplot(fig6_data, aes(x = year, y = coef)) +
  geom_point(size = 3) +
  geom_errorbar(aes(ymin = lower, ymax = upper), width = 0.2) +
  geom_hline(yintercept = 0, linetype = "dashed", color = "gray40") +
  labs(x = "Year", y = "Coefficient (Internet_std × Year)",
       title = "Figure 6: Event Study (Reference Year = 2019)") +
  scale_x_continuous(breaks = c(2017, 2018, 2019, 2021)) +
  theme_minimal(base_size = 12)
ggsave(paste0(downloads_path, "figure6_event_study.png"), plot = p6, width = 6, height = 4, dpi = 300)

