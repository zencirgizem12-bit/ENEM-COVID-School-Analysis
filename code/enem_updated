# ======================================================
# 06_iv_positive_mort.R
# IV only on municipalities with positive excess mortality
# ======================================================

library(AER)
library(lmtest)
library(sandwich)

# Load processed data
city_panel_full <- readRDS("city_panel_processed.rds")

# Keep only municipalities with positive excess mortality
positive_mort <- city_panel_full[city_panel_full$excess_mortality_positive > 0, ]

# IV on positive mortality subsample (simple)
iv_pos <- ivreg(math_mean ~ D + factor(city_code) + factor(year) |
                  Z + factor(city_code) + factor(year), data = positive_mort)
iv_pos_summary <- summary(iv_pos, diagnostics = TRUE)

# IV + controls on positive mortality subsample
iv_pos_controls <- ivreg(math_mean ~ D + income_median + pct_urban + factor(city_code) + factor(year) |
                           Z + income_median + pct_urban + factor(city_code) + factor(year),
                         data = positive_mort)
iv_pos_controls_summary <- summary(iv_pos_controls, diagnostics = TRUE)

# Save results
save(iv_pos_summary, iv_pos_controls_summary, file = "iv_positive_mort_results.RData")

# Print results
cat("\n=== IV (positive mortality subsample, simple) ===\n")
print(iv_pos_summary$coefficients["D", ])
cat("\n=== First-stage F statistic ===\n")
print(iv_pos_summary$diagnostics["Weak instruments", ])
cat("\n=== IV + controls (positive mortality subsample) ===\n")
print(iv_pos_controls_summary$coefficients["D", ])

