med_internet <- median(city_panel_full$internet_std, na.rm = TRUE)
med_mort <- median(city_panel_full$excess_mortality_positive, na.rm = TRUE)

city_panel_full$internet_group <- ifelse(city_panel_full$internet_std > med_internet,
